# Database
# Runtime (recommended for local app runtime with Supabase): Supavisor Session pooler (port 5432)
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Migrations / Prisma db push: direct DB URL (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Optional for serverless/auto-scaling runtimes only: Supavisor Transaction pooler (port 6543)
# DATABASE_URL_SERVERLESS="postgresql://USER.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Optional retry for transient Prisma read connectivity failures (P1001)
PRISMA_READ_RETRIES=2

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
