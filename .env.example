

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Local Next.js runtime: use Supavisor Session pooler on port 5432.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# Prisma migrations/backups: direct database URL.
DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace_with_a_long_random_secret
INACTIVE_STUDENT_DAYS=30
# Optional branded video. The homepage uses /landing/1.jpeg when unset.
NEXT_PUBLIC_HERO_VIDEO_URL=
